@model ECommerce.AdminPanel.Models.Products.ProductListViewModel
@{
    Layout = "_Layout";
    var productList = Model.Products.Items;
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title">Ürün Yönetimi</h1>
    <a asp-action="Create" class="btn btn-primary-gradient">
        <i class="fas fa-plus me-2"></i>Yeni Ürün
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Ürün</th>
                        <th>Fiyat</th>
                        <th>Stok</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in productList)
                    {
                        <tr>
                            <td>@product.Name</td>
                            <td>@product.Price TL</td>
                            <td>@product.Stock</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                                <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
